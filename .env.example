# CareCircle Configuration
# Copy to .env and fill in values

# Server
HOST=127.0.0.1
PORT=8000

# Origin allowlist (comma-separated). Empty = allow all when no Origin header.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database
DATABASE_PATH=carecircle.db

# LLM Provider for voice client
# Option 1: Amazon Bedrock via Strands (set AWS creds)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0

# Option 2: OpenAI-compatible (fallback when no AWS creds)
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# Client Configuration
CLIENT_PORT=8001
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
CLIENT_ORIGIN=http://localhost:8001

# Demo tokens are generated by scripts/seed.py and saved in scripts/.tokens.json

